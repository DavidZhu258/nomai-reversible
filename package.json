{
  "name": "nomai-reversible",
  "version": "0.1.0",
  "description": "Reversible Nomai-style spiral text encoder inspired by Outer Wilds and NomaiText.jl.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "nomai": "./dist/cli.js"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
